# Copy values from this file into your deployment provider environment variables.
# Do not commit real secrets.

GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3-flash-preview

# Runtime connection: use Supabase Transaction Pooler.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Migration connection: use Supabase direct connection.
DATABASE_URL_SYNC=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

JWT_SECRET_KEY=your-supabase-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TEMP_PASSWORD_LENGTH=20

APP_NAME=CogniScan API
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
SQL_ECHO=false
HOST=0.0.0.0
PORT=8000
RELOAD=false

# This deploy profile is intended for one GCP backend instance.
# If you later scale to multiple instances, set this false and use centralized
# rate-limit storage such as Memorystore Redis.
DEPLOYMENT_SINGLE_INSTANCE=true

# Replace with the deployed frontend URL. Separate multiple origins with commas.
CORS_ORIGINS=https://your-frontend-domain.example
FRONTEND_LOGIN_URL=https://your-frontend-domain.example/sign-in

# Use a persistent disk or object storage-backed path if psikolog documents
# must survive container restarts.
FILE_STORAGE_DIR=storage
PSIKOLOG_DOCUMENT_MAX_BYTES=10485760

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_SENDER_EMAIL=no-reply@cogniscan.example
SMTP_USE_TLS=true

MIDTRANS_SERVER_KEY=Mid-server-your-production-server-key
MIDTRANS_CLIENT_KEY=Mid-client-your-production-client-key
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SNAP_BASE_URL=https://app.midtrans.com
MIDTRANS_API_BASE_URL=https://api.midtrans.com
MIDTRANS_FINISH_URL=https://your-frontend-domain.example/pasien/booking/receipt/detail

JITSI_BASE_URL=https://meet.jit.si

WAHA_ENABLED=false
WAHA_BASE_URL=https://your-waha-service.example
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
WAHA_SEND_TIMEOUT_SECONDS=15

# Keep this true only when the backend runs as a single instance and WAHA is used.
# For multi-instance production, use a separate worker or external cron.
BOOKING_REMINDER_SCHEDULER_ENABLED=false
BOOKING_REMINDER_INTERVAL_SECONDS=300
BOOKING_REMINDER_RUN_ON_STARTUP=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMIT_TRUST_PROXY_HEADERS=true
RATE_LIMIT_AUTH_MUTATION=10/minute
RATE_LIMIT_SCREENING_FINALIZE=6/minute
RATE_LIMIT_VOICE_ANSWER=20/minute
RATE_LIMIT_PAYMENT_MUTATION=15/minute
RATE_LIMIT_PAYMENT_READ=60/minute
RATE_LIMIT_ADMIN_ACTION=30/minute
RATE_LIMIT_REMINDER_DISPATCH=6/minute
RATE_LIMIT_SCHEDULE_MUTATION=60/minute
RATE_LIMIT_CONSULTATION_RESULT=12/minute
