GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3-flash-preview

DATABASE_URL=postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL_SYNC=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# Isi dengan Supabase JWT secret agar backend bisa decode access token Supabase.
JWT_SECRET_KEY=your-supabase-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase Auth Admin API. Jangan pernah expose service role key ke frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TEMP_PASSWORD_LENGTH=20

APP_NAME=CogniScan API
APP_VERSION=1.0.0
FILE_STORAGE_DIR=storage
PSIKOLOG_DOCUMENT_MAX_BYTES=10485760
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
RELOAD=true
CORS_ORIGINS=http://localhost:3000
FRONTEND_LOGIN_URL=http://localhost:3000/sign-in

# SMTP dipakai untuk mengirim temporary password psikolog setelah approval admin.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_SENDER_EMAIL=no-reply@cogniscan.local
SMTP_USE_TLS=true

# Midtrans Snap sandbox. Jangan commit key asli.
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_FINISH_URL=http://localhost:3000/pasien/booking/receipt/detail

# Jitsi public room host. Ganti jika nanti memakai Jitsi self-hosted/JaaS.
JITSI_BASE_URL=https://meet.jit.si

# WAHA WhatsApp HTTP API untuk reminder konsultasi pasien.
# Jalankan WAHA terpisah, login session, lalu isi base URL dan API key-nya.
WAHA_ENABLED=false
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
WAHA_SEND_TIMEOUT_SECONDS=15

# Scheduler internal backend untuk memanggil reminder otomatis.
# Interval 300 detik berarti backend mengecek booking jatuh tempo setiap 5 menit.
BOOKING_REMINDER_SCHEDULER_ENABLED=true
BOOKING_REMINDER_INTERVAL_SECONDS=300
BOOKING_REMINDER_RUN_ON_STARTUP=true

# Rate limit ringan untuk endpoint sensitif/mahal.
# Untuk production multi-instance, ganti storage ke Redis/Valkey agar limit tidak per-proses.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMIT_TRUST_PROXY_HEADERS=false
RATE_LIMIT_AUTH_MUTATION=10/minute
RATE_LIMIT_SCREENING_FINALIZE=6/minute
RATE_LIMIT_VOICE_ANSWER=20/minute
RATE_LIMIT_PAYMENT_MUTATION=15/minute
RATE_LIMIT_PAYMENT_READ=60/minute
RATE_LIMIT_ADMIN_ACTION=30/minute
RATE_LIMIT_REMINDER_DISPATCH=6/minute
RATE_LIMIT_SCHEDULE_MUTATION=60/minute
RATE_LIMIT_CONSULTATION_RESULT=12/minute
